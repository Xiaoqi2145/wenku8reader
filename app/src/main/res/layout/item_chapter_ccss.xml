<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  xmlns:tools="http://schemas.android.com/tools"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:background="?selectableItemBackground"
  android:orientation="vertical"
  android:minHeight="@dimen/gi_chapter_row_compact_height"
  android:paddingTop="@dimen/gi_space_sm"
  android:paddingBottom="@dimen/gi_space_sm">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <LinearLayout
      android:layout_gravity="center_vertical"
      android:gravity="center_vertical"
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="match_parent"
      android:orientation="vertical">
      <TextView
        android:id="@+id/tv_i_chapter_ccss"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.GalIsland.ListTitle"
        android:paddingStart="@dimen/gi_space_lg"
        android:paddingEnd="@dimen/gi_space_md"
        tools:text="title" />
      <LinearLayout
        android:paddingStart="@dimen/gi_space_lg"
        android:paddingEnd="@dimen/gi_space_md"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
          android:id="@+id/tv_i_chapter_ccss_completed"
          android:gravity="right"
          android:textStyle="italic"
          android:layout_gravity="center_vertical"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginRight="@dimen/gi_space_inset"
          style="@style/TextAppearance.GalIsland.Meta"
          tools:text="@string/unread" />
        <TextView
          android:id="@+id/tv_i_chapter_ccss_latest"
          android:layout_gravity="center_vertical"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          style="@style/TextAppearance.GalIsland.ListMark"
          tools:text="上次阅读" />
      </LinearLayout>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
      android:id="@+id/b_i_chapter_ccss"
      style="@style/Widget.GalIsland.Button.IconButton"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="@dimen/gi_space_sm"
      android:contentDescription="@string/delete"
      app:icon="@drawable/ic_delete_history"
      android:visibility="invisible"
      tools:visibility="visible" />
  </LinearLayout>
</LinearLayout>
