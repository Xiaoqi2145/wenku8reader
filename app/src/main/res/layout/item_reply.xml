<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_marginLeft="@dimen/gi_space_inset"
  android:layout_marginRight="@dimen/gi_space_inset"
  android:layout_marginTop="@dimen/gi_metric_5dp"
  android:layout_marginBottom="@dimen/gi_metric_5dp"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:background="@drawable/gi_secondary_panel">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">
      <TextView
        android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
        android:id="@+id/tv_i_reply_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/gi_space_inset"
        android:paddingRight="@dimen/gi_space_inset"
        android:paddingTop="@dimen/gi_metric_5dp"
        android:paddingBottom="@dimen/gi_metric_5dp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        tools:text="username" />
      <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
      <TextView
        android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Supporting"
        android:id="@+id/tv_i_reply_floor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingRight="@dimen/gi_space_inset"
        tools:text="1#" />
    </LinearLayout>
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">
      <TextView
        android:lineSpacingMultiplier="1.6"
        android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Body"
        android:id="@+id/tv_i_reply_comment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/gi_space_inset"
        android:textIsSelectable="true"
        tools:text="reply" />
    </LinearLayout>
    <LinearLayout
      android:layout_marginTop="@dimen/gi_space_inset"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:padding="@dimen/gi_space_inset">
      <TextView
        android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Supporting"
        android:id="@+id/tv_i_reply_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="time" />
      <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
    </LinearLayout>
  </LinearLayout>
  <com.google.android.material.divider.MaterialDivider
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:dividerThickness="@dimen/gi_stroke"
    app:dividerColor="?attr/colorOutlineVariant" />
</LinearLayout>