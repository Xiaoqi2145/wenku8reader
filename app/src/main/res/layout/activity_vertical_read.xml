<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent">
  <androidx.fragment.app.FragmentContainerView
    android:id="@+id/fcv_a_v_read"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />
  <include
    android:id="@+id/i_a_v_read_guide"
    layout="@layout/view_vertical_read_guide"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />
  <!-- 与主视觉二级页同一工具栏样式（Secondary.Toolbar = Toolbar + elevation 0dp）；
       透明底、minHeight、elevation 均由样式提供，不在布局重复声明。 -->
  <com.google.android.material.appbar.MaterialToolbar
    android:id="@+id/tb_a_v_read"
    style="@style/Widget.GalIsland.Secondary.Toolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:title="title"
    app:menu="@menu/menu_act_v_h_read" />
  <!--
    ~ 常显状态行独立于底栏 dock：菜单呼出时由 ReaderChromeController 淡出，
    ~ 菜单隐藏时恢复，避免菜单下方残留一条同色带与双重描边。
  -->
  <include
    android:id="@+id/status_a_v_read"
    layout="@layout/view_read_status_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/gi_reader_status_line_height"
    android:layout_gravity="bottom" />
  <!--
    ~ 底栏 dock 只承载菜单本体并独占背景；隐藏时整个 dock（含背景与描边）
    ~ 被平移出屏幕底缘，不再留下浮空占位。宽屏下内容限宽居中。
  -->
  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/read_bottom_dock"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/bg_read_bottom_bar">
    <include
      android:id="@+id/bar_a_v_read"
      layout="@layout/view_read_bottom_bar"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintWidth_max="@dimen/gi_reader_dock_max_width" />
  </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
