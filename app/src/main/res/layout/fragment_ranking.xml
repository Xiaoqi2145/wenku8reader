<?xml version="1.0" encoding="utf-8"?>
<com.cyh128.hikari_novel.ui.other.LibrarySurfaceLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="?android:attr/colorBackground"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools">
  <com.google.android.material.appbar.AppBarLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:liftOnScrollTargetViewId="@id/fcv_f_ranking"
    app:layout_behavior="com.google.android.material.appbar.AppBarLayout$Behavior"
    style="@style/Widget.GalIsland.AppBar"
    android:elevation="0dp"
    android:background="@android:color/transparent">
    <com.google.android.material.textfield.TextInputLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:padding="@dimen/gi_space_gap_xl"
      android:hint="@string/ranking"
      app:layout_scrollFlags="scroll|enterAlways"
      style="@style/Widget.GalIsland.TextInputLayout.OutlinedBox.Dropdown">
      <com.google.android.material.textfield.MaterialAutoCompleteTextView
        android:id="@+id/act_f_ranking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="none"
        app:simpleItems="@array/ranking"
        tools:ignore="LabelFor" />
    </com.google.android.material.textfield.TextInputLayout>
  </com.google.android.material.appbar.AppBarLayout>
  <androidx.fragment.app.FragmentContainerView
    android:id="@+id/fcv_f_ranking"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior" />
</com.cyh128.hikari_novel.ui.other.LibrarySurfaceLayout>