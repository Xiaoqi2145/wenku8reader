<?xml version="1.0" encoding="utf-8"?>
<com.cyh128.hikari_novel.ui.other.GalislandGridConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:fitsSystemWindows="true"
  android:orientation="vertical"
  android:background="?android:attr/colorBackground">
  <ImageView
    android:id="@+id/iv_a_crash"
    app:layout_constraintTop_toTopOf="parent"
    android:layout_width="match_parent"
    android:layout_height="@dimen/gi_metric_130dp"
    android:src="@drawable/logo_header"
    android:contentDescription="@null" />
  <TextView
    android:textAppearance="@style/TextAppearance.GalIsland.Heading"
    android:id="@+id/tv_a_crash_text1"
    app:layout_constraintTop_toBottomOf="@id/iv_a_crash"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:text="@string/app_crashed"
    android:textStyle="bold" />
  <TextView
    android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
    android:id="@+id/tv_a_crash_tip"
    app:layout_constraintTop_toBottomOf="@id/tv_a_crash_text1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/gi_radius_tag"
    android:paddingLeft="@dimen/gi_control_icon"
    android:paddingRight="@dimen/gi_control_icon"
    android:text="@string/crash_tip"
    android:textStyle="bold"
    android:textColor="?attr/colorPrimary" />
  <androidx.core.widget.NestedScrollView
    app:layout_constraintTop_toBottomOf="@+id/tv_a_crash_tip"
    app:layout_constraintBottom_toTopOf="@id/l_a_crash"
    android:layout_marginTop="@dimen/gi_space_inset"
    android:layout_marginRight="@dimen/gi_metric_30dp"
    android:layout_marginLeft="@dimen/gi_metric_30dp"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:requiresFadingEdge="vertical"
    android:fadingEdgeLength="@dimen/gi_metric_100dp">
    <TextView
      android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
      android:id="@+id/tv_a_crash_error_msg"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      tools:text="error"
      android:textIsSelectable="true"
      android:fontFamily="monospace"
      android:padding="@dimen/gi_space_md"
      android:background="@drawable/gi_secondary_panel" />
  </androidx.core.widget.NestedScrollView>
  <LinearLayout
    android:id="@+id/l_a_crash"
    app:layout_constraintBottom_toBottomOf="parent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/gi_control_icon">
    <com.google.android.material.button.MaterialButton
      android:minHeight="@dimen/gi_control_height"
      android:id="@+id/b_a_crash_setting"
      style="@style/Widget.GalIsland.Button.Outlined"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/setting" />
    <com.google.android.material.button.MaterialButton
      android:minHeight="@dimen/gi_control_height"
      android:id="@+id/b_a_crash_report"
      style="@style/Widget.GalIsland.Button.Outlined"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/report_to_developer" />
    <com.google.android.material.button.MaterialButton
      android:minHeight="@dimen/gi_control_height"
      style="@style/Widget.GalIsland.Button"
      android:id="@+id/b_a_crash_restart"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/restart_app" />
  </LinearLayout>
</com.cyh128.hikari_novel.ui.other.GalislandGridConstraintLayout>