<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/ll_i_read_chapter_catalog_chapter"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@drawable/bg_read_catalog_item"
  android:clickable="true"
  android:focusable="true"
  android:foreground="?attr/selectableItemBackground"
  android:gravity="center_vertical"
  android:minHeight="@dimen/gi_control_height"
  android:orientation="horizontal"
  android:paddingStart="@dimen/gi_space_sm"
  android:paddingTop="@dimen/gi_space_xs"
  android:paddingEnd="@dimen/gi_space_lg"
  android:paddingBottom="@dimen/gi_space_xs"
  android:stateListAnimator="@null">

  <View
    android:id="@+id/v_i_read_chapter_catalog_current_marker"
    android:layout_width="@dimen/gi_stroke"
    android:layout_height="@dimen/gi_metric_30dp"
    android:layout_marginEnd="@dimen/gi_space_sm"
    android:background="?attr/colorPrimary"
    android:visibility="gone"
    tools:visibility="visible" />

  <CheckBox
    android:id="@+id/cb_i_read_chapter_catalog_download"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:contentDescription="@string/download_chapter"
    android:visibility="gone"
    tools:visibility="visible" />

  <TextView
    android:id="@+id/tv_i_read_chapter_catalog_chapter_number"
    android:layout_width="@dimen/gi_catalog_chapter_number_width"
    android:layout_height="wrap_content"
    android:duplicateParentState="true"
    android:gravity="center_vertical"
    android:textColor="@color/read_catalog_item_text"
    style="@style/TextAppearance.GalIsland.Meta"
    tools:text="第12章" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/tv_i_read_chapter_catalog_chapter_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:duplicateParentState="true"
      android:ellipsize="end"
      android:maxLines="2"
      android:textColor="@color/read_catalog_item_text"
      style="@style/TextAppearance.GalIsland.ListTitle"
      tools:text="新的旅程从这里开始" />

    <TextView
      android:id="@+id/tv_i_read_chapter_catalog_current"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/gi_space_xxs"
      android:duplicateParentState="true"
      android:text="@string/current_chapter"
      android:textColor="?attr/colorPrimary"
      style="@style/TextAppearance.GalIsland.ListMark"
      android:visibility="gone"
      tools:visibility="visible" />
  </LinearLayout>
</LinearLayout>
