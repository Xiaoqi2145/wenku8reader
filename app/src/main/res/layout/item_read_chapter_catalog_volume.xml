<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/fl_i_read_chapter_catalog_volume"
  android:layout_width="match_parent"
  android:layout_height="@dimen/gi_catalog_volume_item_height"
  android:background="@drawable/bg_read_catalog_item"
  android:clickable="true"
  android:focusable="true"
  android:foreground="?attr/selectableItemBackground"
  android:minHeight="@dimen/gi_control_height"
  android:paddingStart="@dimen/gi_space_sm"
  android:paddingEnd="@dimen/gi_space_xs"
  android:stateListAnimator="@null">

  <View
    android:id="@+id/v_i_read_chapter_catalog_volume_indicator"
    android:layout_width="@dimen/gi_stroke"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/gi_space_xs"
    android:layout_marginBottom="@dimen/gi_space_xs"
    android:background="?attr/colorPrimary"
    android:visibility="gone"
    tools:visibility="visible" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/gi_space_md"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <TextView
      android:id="@+id/tv_i_read_chapter_catalog_volume_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:duplicateParentState="true"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/read_catalog_item_text"
      style="@style/TextAppearance.GalIsland.CardTitle"
      tools:text="第一卷 启程" />

    <TextView
      android:id="@+id/tv_i_read_chapter_catalog_volume_count"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:duplicateParentState="true"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/read_catalog_item_text"
      style="@style/TextAppearance.GalIsland.Meta"
      tools:text="24章" />
  </LinearLayout>
</FrameLayout>
