<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="?selectableItemBackground"
  android:orientation="horizontal"
  android:minHeight="@dimen/gi_metric_58dp"
  android:paddingTop="@dimen/gi_space_inset"
  android:paddingBottom="@dimen/gi_space_inset"
  android:gravity="center_vertical"
  xmlns:tools="http://schemas.android.com/tools">
  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">
    <TextView
      android:id="@+id/tv_i_chapter_vcss"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      style="@style/TextAppearance.GalIsland.SectionTitle"
      android:paddingStart="@dimen/gi_space_lg"
      android:paddingEnd="@dimen/gi_space_inset"
      tools:text="title" />
    <TextView
      android:id="@+id/tv_i_chapter_vcss_completed"
      android:gravity="right"
      style="@style/TextAppearance.GalIsland.Meta"
      android:layout_marginEnd="@dimen/gi_control_icon"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textStyle="italic"
      android:paddingStart="@dimen/gi_space_lg"
      tools:text="阅读完成" />
  </LinearLayout>
  <ImageView
    android:id="@+id/iv_i_chapter_vcss"
    android:layout_width="@dimen/gi_metric_15dp"
    android:layout_height="@dimen/gi_metric_15dp"
    android:src="@drawable/ic_arrow_down"
    android:layout_marginEnd="@dimen/gi_space_lg"
    android:contentDescription="@string/chapter_catalog" />
</LinearLayout>