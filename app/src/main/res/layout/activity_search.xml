<?xml version="1.0" encoding="utf-8"?>
<com.cyh128.hikari_novel.ui.other.LibrarySurfaceLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="?android:attr/colorBackground"
  xmlns:tools="http://schemas.android.com/tools"
  android:fitsSystemWindows="true"
  xmlns:app="http://schemas.android.com/apk/res-auto">
  <com.google.android.material.appbar.AppBarLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="true"
    style="@style/Widget.GalIsland.AppBar"
    android:elevation="0dp"
    android:background="@android:color/transparent">
    <com.google.android.material.appbar.CollapsingToolbarLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:layout_scrollFlags="scroll|exitUntilCollapsed"
      app:titleEnabled="false">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="?attr/actionBarSize"
        app:layout_collapseMode="parallax">
        <com.google.android.material.textfield.TextInputLayout
          android:id="@+id/tl_a_search"
          style="@style/Widget.GalIsland.TextInputLayout.OutlinedBox"
          android:paddingLeft="@dimen/gi_page_inset"
          android:paddingRight="@dimen/gi_page_inset"
          android:hint="@string/search"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:endIconMode="clear_text">
          <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/tiet_a_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:minHeight="@dimen/gi_control_height"
            android:textSize="@dimen/gi_text_card_title"
            android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/search_method"
          android:paddingLeft="@dimen/gi_page_inset"
          android:layout_marginTop="@dimen/gi_space_lg"
          style="@style/TextAppearance.GalIsland.SectionTitle" />
        <com.google.android.material.chip.ChipGroup
          android:paddingLeft="@dimen/gi_page_inset"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:checkedChip="@id/c_a_search_by_novel_title"
          app:selectionRequired="true"
          app:singleSelection="true">
          <com.google.android.material.chip.Chip
            android:id="@+id/c_a_search_by_novel_title"
            style="@style/Widget.GalIsland.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/by_novel_title" />
          <com.google.android.material.chip.Chip
            android:id="@+id/c_a_search_by_author"
            style="@style/Widget.GalIsland.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/by_author" />
        </com.google.android.material.chip.ChipGroup>
        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/search_history"
          android:paddingLeft="@dimen/gi_page_inset"
          android:layout_marginTop="@dimen/gi_space_lg"
          style="@style/TextAppearance.GalIsland.SectionTitle" />
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingLeft="@dimen/gi_page_inset"
          android:paddingRight="@dimen/gi_page_inset"
          android:paddingBottom="@dimen/gi_space_gap_xl"
          android:gravity="center"
          android:orientation="horizontal">
          <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_a_search"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:fadingEdgeLength="@dimen/gi_section_gap"
            android:requiresFadingEdge="horizontal"
            tools:listitem="@layout/item_search_history" />
          <com.google.android.material.button.MaterialButton
            style="@style/Widget.GalIsland.Button.IconButton"
            android:id="@+id/b_a_search_clear_all_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_delete"
            android:tooltipText="@string/clear_all_search_history"
            tools:targetApi="o" />
        </LinearLayout>
      </LinearLayout>
      <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/tb_a_search"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        app:title="@string/search"
        android:minHeight="@dimen/gi_toolbar_height"
        android:background="@android:color/transparent"
        android:elevation="0dp" />
    </com.google.android.material.appbar.CollapsingToolbarLayout>
  </com.google.android.material.appbar.AppBarLayout>
  <androidx.core.widget.NestedScrollView
    android:fillViewport="true"
    app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.fragment.app.FragmentContainerView
      android:id="@+id/fcv_a_search"
      android:layout_width="match_parent"
      android:layout_height="match_parent" />
  </androidx.core.widget.NestedScrollView>
</com.cyh128.hikari_novel.ui.other.LibrarySurfaceLayout>
