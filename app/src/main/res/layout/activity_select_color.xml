<?xml version="1.0" encoding="utf-8"?>
<com.cyh128.hikari_novel.ui.other.LibrarySurfaceLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="?android:attr/colorBackground"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:orientation="vertical"
  android:fitsSystemWindows="true">
  <com.google.android.material.appbar.AppBarLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="true"
    style="@style/Widget.GalIsland.AppBar"
    android:elevation="0dp"
    android:background="@android:color/transparent">
    <com.google.android.material.appbar.MaterialToolbar
      android:id="@+id/tb_a_select_color"
      android:layout_width="match_parent"
      android:layout_height="?attr/actionBarSize"
      app:title="选择颜色"
      android:minHeight="@dimen/gi_toolbar_height"
      android:background="@android:color/transparent"
      android:elevation="0dp" />
  </com.google.android.material.appbar.AppBarLayout>
  <androidx.core.widget.NestedScrollView
    app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical">
      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tl_a_select_color_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/gi_page_inset"
        android:layout_marginTop="@dimen/gi_space_gap_xl"
        android:layout_marginRight="@dimen/gi_page_inset"
        android:hint="字体颜色(十六进制)">
        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/tiet_a_select_color_text"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:minHeight="@dimen/gi_control_height"
          android:textSize="@dimen/gi_text_card_title"
          android:singleLine="true" />
      </com.google.android.material.textfield.TextInputLayout>
      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tl_a_select_color_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/gi_page_inset"
        android:layout_marginTop="@dimen/gi_space_gap_xl"
        android:layout_marginRight="@dimen/gi_page_inset"
        android:hint="背景颜色(十六进制)">
        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/tiet_a_select_color_bg"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:minHeight="@dimen/gi_control_height"
          android:textSize="@dimen/gi_text_card_title"
          android:singleLine="true" />
      </com.google.android.material.textfield.TextInputLayout>
      <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_a_select_color_recommend_day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/gi_space_gap_xl"
        style="@style/Widget.GalIsland.CardView">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:padding="@dimen/gi_space_md">
          <ImageView
            android:layout_width="@dimen/gi_control_icon"
            android:layout_height="@dimen/gi_control_icon"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_info" />
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginLeft="@dimen/gi_space_gap_md">
            <TextView
              style="@style/TextAppearance.GalIsland.Secondary.Title"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:textSize="@dimen/gi_text_novel_title_plain"
              android:textStyle="bold"
              android:text="浅色主题推荐字体颜色" />
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:textSize="@dimen/gi_text_card_title"
              android:text="000000" />
            <TextView
              style="@style/TextAppearance.GalIsland.Secondary.Title"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:textSize="@dimen/gi_text_novel_title_plain"
              android:textStyle="bold"
              android:text="浅色主题推荐背景颜色" />
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:textSize="@dimen/gi_text_card_title"
              android:text="CEC29C，D1CEC5，CCEBCC，FFFFFF" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_a_select_color_recommend_night"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/gi_space_gap_xl"
        style="@style/Widget.GalIsland.CardView">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:padding="@dimen/gi_space_md">
          <ImageView
            android:layout_width="@dimen/gi_control_icon"
            android:layout_height="@dimen/gi_control_icon"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_info" />
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginLeft="@dimen/gi_space_gap_md">
            <TextView
              style="@style/TextAppearance.GalIsland.Secondary.Title"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:textSize="@dimen/gi_text_novel_title_plain"
              android:textStyle="bold"
              android:text="深色主题推荐字体颜色" />
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:textSize="@dimen/gi_text_card_title"
              android:text="FFFFFF" />
            <TextView
              style="@style/TextAppearance.GalIsland.Secondary.Title"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:textSize="@dimen/gi_text_novel_title_plain"
              android:textStyle="bold"
              android:text="深色主题推荐背景颜色" />
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:textSize="@dimen/gi_text_card_title"
              android:text="2C2C2C，000000" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="right">
        <com.google.android.material.button.MaterialButton
          android:id="@+id/b_a_select_color_cancel"
          style="@style/Widget.GalIsland.Button.Text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/cancel" />
        <com.google.android.material.button.MaterialButton
          style="@style/Widget.GalIsland.Button"
          android:id="@+id/b_a_select_color_save"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="right"
          android:layout_marginRight="@dimen/gi_page_inset"
          android:text="@string/save_config" />
      </LinearLayout>
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</com.cyh128.hikari_novel.ui.other.LibrarySurfaceLayout>
