<?xml version="1.0" encoding="utf-8"?>
<com.cyh128.hikari_novel.ui.other.LibrarySurfaceLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="?android:attr/colorBackground">
  <com.google.android.material.appbar.AppBarLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:liftOnScrollTargetViewId="@id/fcv_f_category"
    app:layout_behavior="com.google.android.material.appbar.AppBarLayout$Behavior"
    style="@style/Widget.GalIsland.AppBar"
    android:elevation="0dp"
    android:background="@android:color/transparent">
    <LinearLayout
      app:layout_scrollFlags="scroll|enterAlways"
      android:orientation="vertical"
      android:layout_width="match_parent"
      android:layout_height="wrap_content">
      <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gi_space_gap_xl"
        android:layout_marginLeft="@dimen/gi_page_inset"
        android:layout_marginRight="@dimen/gi_page_inset"
        android:layout_marginBottom="@dimen/gi_space_inset"
        android:hint="@string/category"
        style="@style/Widget.GalIsland.TextInputLayout.OutlinedBox.Dropdown">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
          android:id="@+id/act_f_category"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:inputType="none"
          app:simpleItems="@array/category"
          tools:ignore="LabelFor" />
      </com.google.android.material.textfield.TextInputLayout>
      <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:requiresFadingEdge="horizontal"
        android:paddingLeft="@dimen/gi_page_inset"
        android:paddingRight="@dimen/gi_page_inset"
        android:paddingBottom="@dimen/gi_space_gap_xl"
        android:fadingEdgeLength="@dimen/gi_fade_edge_section"
        android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup
          android:id="@+id/cg_f_category"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:checkedChip="@id/c_f_category_sort_by_update"
          app:selectionRequired="true"
          app:singleSelection="true">
          <com.google.android.material.chip.Chip
            android:id="@+id/c_f_category_sort_by_update"
            style="@style/Widget.GalIsland.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_by_update" />
          <com.google.android.material.chip.Chip
            android:id="@+id/c_f_category_sort_by_heat"
            style="@style/Widget.GalIsland.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_by_heat" />
          <com.google.android.material.chip.Chip
            android:id="@+id/c_f_category_sort_by_completion"
            style="@style/Widget.GalIsland.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_by_completion" />
          <com.google.android.material.chip.Chip
            android:id="@+id/c_f_category_sort_by_animated"
            style="@style/Widget.GalIsland.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_by_animated" />
        </com.google.android.material.chip.ChipGroup>
      </HorizontalScrollView>
    </LinearLayout>
  </com.google.android.material.appbar.AppBarLayout>
  <androidx.fragment.app.FragmentContainerView
    android:id="@+id/fcv_f_category"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior" />
</com.cyh128.hikari_novel.ui.other.LibrarySurfaceLayout>
