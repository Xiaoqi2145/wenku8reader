<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@android:color/black">
  <com.github.chrisbanes.photoview.PhotoView
    android:id="@+id/pv_a_photo_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />
  <com.google.android.material.button.MaterialButton
    android:minHeight="@dimen/gi_control_height"
    android:id="@+id/b_a_photo_view"
    style="@style/Widget.GalIsland.Button.IconButton"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:icon="@drawable/ic_close"
    android:layout_margin="@dimen/gi_space_inset"
    android:layout_marginTop="@dimen/gi_control_icon"
    android:layout_gravity="left"
    android:tooltipText="@string/close"
    app:iconSize="@dimen/gi_space_xl"
    tools:targetApi="o" />
  <com.google.android.material.button.MaterialButton
    android:minHeight="@dimen/gi_control_height"
    android:id="@+id/b_a_photo_web"
    style="@style/Widget.GalIsland.Button.IconButton"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:icon="@drawable/ic_web"
    android:layout_margin="@dimen/gi_space_inset"
    android:layout_gravity="right"
    android:tooltipText="@string/open_in_browser"
    app:iconSize="@dimen/gi_space_xl"
    tools:targetApi="o" />
  <com.google.android.material.progressindicator.CircularProgressIndicator
    android:id="@+id/cpi_a_photo_view"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:indeterminate="true"
    app:hideAnimationBehavior="outward"
    android:layout_gravity="center" />
</FrameLayout>
