<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:orientation="vertical"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:gravity="center"
  android:padding="@dimen/gi_space_xl">
  <ImageView
    android:layout_width="@dimen/gi_metric_64dp"
    android:layout_height="@dimen/gi_metric_64dp"
    android:alpha="0.55"
    android:src="@drawable/ic_empty"
    app:tint="?attr/colorOnSurfaceVariant"
    android:contentDescription="@null" />
  <TextView
    android:layout_marginTop="@dimen/gi_space_md"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    style="@style/TextAppearance.GalIsland.EmptyTitle"
    android:text="@string/empty_content" />
</LinearLayout>