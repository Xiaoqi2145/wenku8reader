<?xml version="1.0" encoding="utf-8"?>
<com.cyh128.hikari_novel.ui.other.LibrarySurfaceLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="?android:attr/colorBackground">
<LinearLayout
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fitsSystemWindows="true"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:orientation="vertical"
  android:background="?android:attr/colorBackground">
  <com.google.android.material.appbar.AppBarLayout
    android:elevation="0dp"
    android:background="?attr/giSurfaceToolbar"
    android:id="@+id/abl_a_about"
    app:layout_constraintTop_toTopOf="parent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Widget.GalIsland.AppBar">
    <com.google.android.material.appbar.MaterialToolbar
      android:id="@+id/tb_a_about"
      style="@style/Widget.GalIsland.Secondary.Toolbar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:title="@string/about" />
  </com.google.android.material.appbar.AppBarLayout>
  <LinearLayout
    app:layout_constraintTop_toBottomOf="@id/abl_a_about"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <ImageView
      android:id="@+id/header"
      android:layout_width="wrap_content"
      android:layout_height="@dimen/gi_metric_156dp"
      android:padding="@dimen/gi_space_xl"
      android:src="@drawable/logo_header"
      tools:ignore="MissingConstraints"
      android:contentDescription="@null" />
    <com.google.android.material.divider.MaterialDivider
      app:dividerThickness="@dimen/gi_stroke"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:dividerColor="?attr/colorOutlineVariant" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginLeft="@dimen/gi_space_lg"
      android:layout_marginRight="@dimen/gi_space_lg"
      android:background="@drawable/gi_secondary_panel"
      android:paddingLeft="@dimen/gi_space_lg"
      android:paddingRight="@dimen/gi_space_lg"
      android:paddingTop="@dimen/gi_control_icon"
      android:paddingBottom="@dimen/gi_space_inset"
      android:orientation="vertical">
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
        android:text="@string/app_version" />
      <TextView
        android:id="@+id/tv_a_about"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Supporting"
        tools:text="versionName" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/ll_a_about_update"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="?selectableItemBackground"
      android:layout_marginLeft="@dimen/gi_space_lg"
      android:layout_marginRight="@dimen/gi_space_lg"
      android:minHeight="@dimen/gi_toolbar_height"
      android:padding="@dimen/gi_space_lg"
      android:orientation="vertical">
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
        android:text="@string/check_update" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/ll_a_about_help"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="?selectableItemBackground"
      android:layout_marginLeft="@dimen/gi_space_lg"
      android:layout_marginRight="@dimen/gi_space_lg"
      android:minHeight="@dimen/gi_toolbar_height"
      android:padding="@dimen/gi_space_lg"
      android:orientation="vertical">
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
        android:text="@string/using_help" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/ll_a_about_disclaimers"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="?selectableItemBackground"
      android:layout_marginLeft="@dimen/gi_space_lg"
      android:layout_marginRight="@dimen/gi_space_lg"
      android:minHeight="@dimen/gi_toolbar_height"
      android:padding="@dimen/gi_space_lg"
      android:orientation="vertical">
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
        android:text="@string/disclaimers" />
    </LinearLayout>
  </LinearLayout>
  <View
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="@dimen/gi_metric_30dp"
    android:gravity="center">
    <com.google.android.material.button.MaterialButton
      android:minHeight="@dimen/gi_control_height"
      android:id="@+id/b_a_about_github"
      style="@style/Widget.GalIsland.Button.Outlined"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      app:icon="@drawable/ic_github"
      android:text="Github" />
    <com.google.android.material.button.MaterialButton
      android:minHeight="@dimen/gi_control_height"
      android:id="@+id/b_a_about_telegram"
      style="@style/Widget.GalIsland.Button.Outlined"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      app:icon="@drawable/ic_telegram"
      android:text="Telegram" />
  </LinearLayout>
</LinearLayout>
</com.cyh128.hikari_novel.ui.other.LibrarySurfaceLayout>