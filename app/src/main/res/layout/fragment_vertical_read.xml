<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/nsv_f_v_read"
  android:orientation="vertical"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:paddingLeft="@dimen/gi_control_icon"
  android:paddingRight="@dimen/gi_control_icon">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <Button
      android:id="@+id/b_f_v_read_previous_chapter"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/gi_control_icon"
      android:layout_marginBottom="@dimen/gi_control_icon"
      android:layout_marginLeft="@dimen/gi_rail_width"
      android:layout_marginRight="@dimen/gi_rail_width"
      android:text="@string/previous_chapter" />
    <TextView
      android:id="@+id/tv_f_v_read"
      android:layout_width="match_parent"
      android:layout_height="wrap_content" />
    <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/rv_f_v_read"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:nestedScrollingEnabled="false" />
    <TextView
      android:id="@+id/tv_f_v_read_end_tip"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:fitsSystemWindows="true"
      android:layout_marginTop="@dimen/gi_control_icon"
      android:layout_marginBottom="@dimen/gi_control_icon"
      android:gravity="center"
      android:textSize="@dimen/gi_metric_20sp"
      android:textStyle="bold"
      android:text="已经到底了" />
    <Button
      android:id="@+id/b_f_v_read_next_chapter"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/gi_space_inset"
      android:layout_marginBottom="@dimen/gi_control_icon"
      android:layout_marginLeft="@dimen/gi_rail_width"
      android:layout_marginRight="@dimen/gi_rail_width"
      android:text="@string/next_chapter" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>