<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/nsv_f_v_read"
  android:orientation="vertical"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:clipToPadding="false"
  android:paddingLeft="@dimen/gi_page_inset"
  android:paddingRight="@dimen/gi_page_inset"
  android:paddingBottom="@dimen/gi_reader_content_bottom_inset">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <com.google.android.material.button.MaterialButton
      android:id="@+id/b_f_v_read_previous_chapter"
      style="@style/Widget.GalIsland.Button.Outlined"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center_horizontal"
      android:layout_marginTop="@dimen/gi_space_gap_xl"
      android:layout_marginBottom="@dimen/gi_space_gap_xl"
      android:layout_marginLeft="@dimen/gi_page_inset"
      android:layout_marginRight="@dimen/gi_page_inset"
      android:text="@string/previous_chapter"
      app:icon="@drawable/ic_skip_previous"
      app:iconGravity="textStart" />
    <TextView
      android:id="@+id/tv_f_v_read"
      android:layout_width="match_parent"
      android:layout_height="wrap_content" />
    <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/rv_f_v_read"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:nestedScrollingEnabled="false" />
    <TextView
      android:id="@+id/tv_f_v_read_end_tip"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:fitsSystemWindows="true"
      android:layout_marginTop="@dimen/gi_space_gap_xl"
      android:layout_marginBottom="@dimen/gi_space_gap_xl"
      android:gravity="center"
      android:textSize="@dimen/gi_text_reader_end"
      android:textStyle="bold"
      android:text="@string/chapter_end" />
    <com.google.android.material.button.MaterialButton
      android:id="@+id/b_f_v_read_next_chapter"
      style="@style/Widget.GalIsland.Button.Outlined"
      android:layout_width="wrap_content"
      android:layout_gravity="center_horizontal"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/gi_space_inset"
      android:layout_marginBottom="@dimen/gi_space_gap_xl"
      android:layout_marginLeft="@dimen/gi_page_inset"
      android:layout_marginRight="@dimen/gi_page_inset"
      android:text="@string/next_chapter"
      app:icon="@drawable/ic_skip_next"
      app:iconGravity="textStart" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
