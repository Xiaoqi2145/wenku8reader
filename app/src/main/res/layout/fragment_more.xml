<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fitsSystemWindows="true"
  android:orientation="vertical"
  android:clipToPadding="false"
  android:padding="@dimen/gi_space_lg"
  android:background="?android:attr/colorBackground">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/gi_secondary_panel"
    android:orientation="vertical"
    android:paddingBottom="@dimen/gi_space_xs">
    <ImageView
      android:id="@+id/header"
      android:layout_width="wrap_content"
      android:layout_height="@dimen/gi_metric_156dp"
      android:padding="@dimen/gi_space_xl"
      android:src="@drawable/logo_header"
      tools:ignore="MissingConstraints"
      android:contentDescription="@null" />
    <com.google.android.material.divider.MaterialDivider
      app:dividerThickness="@dimen/gi_stroke"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:dividerColor="?attr/colorOutlineVariant" />
    <LinearLayout
      android:id="@+id/ll_f_more_account"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="?attr/selectableItemBackground"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center_vertical"
      android:minHeight="@dimen/gi_toolbar_height"
      android:orientation="horizontal">
      <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/gi_status_icon"
        android:contentDescription="@null"
        android:paddingLeft="@dimen/gi_space_sm"
        android:src="@drawable/ic_person"
        app:tint="?colorOnSurface" />
      <TextView
        android:text="@string/account"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/gi_metric_5dp"
        android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/ll_f_more_setting"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="?attr/selectableItemBackground"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center_vertical"
      android:minHeight="@dimen/gi_toolbar_height"
      android:orientation="horizontal">
      <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/gi_status_icon"
        android:contentDescription="@null"
        android:paddingLeft="@dimen/gi_space_sm"
        android:src="@drawable/ic_setting"
        app:tint="?colorOnSurface" />
      <TextView
        android:text="@string/setting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/gi_metric_5dp"
        android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/ll_f_more_about"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="?attr/selectableItemBackground"
      android:clickable="true"
      android:focusable="true"
      android:gravity="center_vertical"
      android:minHeight="@dimen/gi_toolbar_height"
      android:orientation="horizontal">
      <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/gi_status_icon"
        android:contentDescription="@null"
        android:paddingLeft="@dimen/gi_space_sm"
        android:src="@drawable/ic_info"
        app:tint="?colorOnSurface" />
      <TextView
        android:text="@string/about"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/gi_metric_5dp"
        android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title" />
    </LinearLayout>
  </LinearLayout>
</androidx.core.widget.NestedScrollView>