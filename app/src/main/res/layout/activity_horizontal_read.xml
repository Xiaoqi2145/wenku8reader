<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent">
  <com.cyh128.hikari_novel.ui.read.horizontal.PageView
    android:id="@+id/pv_a_h_read"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />
  <include
    android:id="@+id/i_a_h_read_guide"
    layout="@layout/view_horizontal_read_guide" />
  <com.google.android.material.appbar.MaterialToolbar
    android:id="@+id/tb_a_h_read"
    style="@style/Widget.GalIsland.Toolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/giSurfaceToolbar"
    tools:title="title"
    app:menu="@menu/menu_act_v_h_read"
    android:minHeight="@dimen/gi_toolbar_height"
    android:elevation="0dp" />
  <!-- 常显状态行独立于底栏 dock，见 activity_vertical_read.xml 的说明。 -->
  <include
    android:id="@+id/status_a_h_read"
    layout="@layout/view_read_status_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/gi_reader_status_line_height"
    android:layout_gravity="bottom" />
  <!-- 底栏 dock 只承载菜单本体并独占背景；宽屏下内容限宽居中。 -->
  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/read_bottom_dock"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/bg_read_bottom_bar">
    <include
      android:id="@+id/bar_a_h_read"
      layout="@layout/view_read_bottom_bar"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintWidth_max="@dimen/gi_reader_dock_max_width" />
  </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
