<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:padding="@dimen/gi_space_inset"
  android:orientation="horizontal"
  android:background="@drawable/gi_secondary_panel"
  android:layout_marginBottom="@dimen/gi_space_sm">
  <TextView
    android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Body"
    android:id="@+id/tv_download_chapter_title"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:maxLines="2" />
  <TextView
    android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Supporting"
    android:id="@+id/tv_download_chapter_status"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginRight="@dimen/gi_space_sm" />
  <com.google.android.material.button.MaterialButton
    android:minHeight="@dimen/gi_control_height"
    android:id="@+id/b_download_chapter_action"
    style="@style/Widget.GalIsland.Button.Text"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/retry" />
</LinearLayout>