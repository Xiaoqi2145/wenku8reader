<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="10dp" android:orientation="horizontal">
    <TextView android:id="@+id/tv_download_chapter_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2" />
    <TextView android:id="@+id/tv_download_chapter_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="8dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/b_download_chapter_action" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/retry" />
</LinearLayout>
