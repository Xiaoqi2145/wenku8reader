<?xml version="1.0" encoding="utf-8"?>
<!--
  阅读设置面板共用的「阅读配色」分组（横排 / 竖排 include 同一份）。

  对齐 Koodo Reader `readerSettings/themeList` 的双轴结构
  （docs/reader-koodo-alignment.md P0-2、docs/plan/reader-settings-round4-plan.md R4-1）：
    · 背景颜色：预设 4 色 + 自定义色（可删）+ 添加
    · 文字颜色：预设 4 色 + 自定义色（可删）+ 添加
  两条轴互相独立；只有「深灰底→白字」「白底+白字→黑字」两条联动规则。

  色块数量随用户保存的自定义色变化，因此用 HorizontalScrollView 承载，
  不写死数量也不会换行撑高面板。hex 输入框保留为精确入口。
-->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@drawable/gi_secondary_panel"
  android:orientation="vertical"
  android:paddingBottom="@dimen/gi_space_md">
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/gi_space_inset"
    android:paddingLeft="@dimen/gi_space_inset"
    android:text="@string/color_settings"
    android:textAppearance="@style/TextAppearance.GalIsland.SectionTitle"
    android:textColor="?attr/colorPrimary" />
  <!-- ========== 背景颜色轴 ========== -->
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="@dimen/gi_space_lg"
    android:paddingTop="@dimen/gi_space_sm"
    android:paddingRight="@dimen/gi_space_lg"
    android:text="@string/bg_color"
    style="@style/TextAppearance.GalIsland.ConfigLabel" />
  <HorizontalScrollView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">
    <com.cyh128.hikari_novel.ui.read.common.ReaderColorSwatchRow
      android:id="@+id/swatch_row_bg"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content" />
  </HorizontalScrollView>
  <!-- ========== 文字颜色轴 ========== -->
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="@dimen/gi_space_lg"
    android:paddingTop="@dimen/gi_space_sm"
    android:paddingRight="@dimen/gi_space_lg"
    android:text="@string/text_color"
    style="@style/TextAppearance.GalIsland.ConfigLabel" />
  <HorizontalScrollView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">
    <com.cyh128.hikari_novel.ui.read.common.ReaderColorSwatchRow
      android:id="@+id/swatch_row_text"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content" />
  </HorizontalScrollView>
  <!-- ========== 精确 hex 入口 ========== -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/gi_secondary_row_height"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/gi_space_lg"
    android:paddingTop="@dimen/gi_space_sm"
    android:paddingRight="@dimen/gi_space_lg"
    android:paddingBottom="@dimen/gi_space_sm">
    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/text_color"
      style="@style/TextAppearance.GalIsland.ConfigLabel" />
    <com.google.android.material.textfield.TextInputLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="2"
      app:boxBackgroundMode="outline">
      <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/edit_text_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/reader_color_hex_hint_dark"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLength="7" />
    </com.google.android.material.textfield.TextInputLayout>
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/gi_secondary_row_height"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/gi_space_lg"
    android:paddingTop="@dimen/gi_space_sm"
    android:paddingRight="@dimen/gi_space_lg"
    android:paddingBottom="@dimen/gi_space_sm">
    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/bg_color"
      style="@style/TextAppearance.GalIsland.ConfigLabel" />
    <com.google.android.material.textfield.TextInputLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="2"
      app:boxBackgroundMode="outline">
      <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/edit_bg_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/reader_color_hex_hint_light"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLength="7" />
    </com.google.android.material.textfield.TextInputLayout>
  </LinearLayout>
  <!-- ========== 动作 ========== -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="@dimen/gi_space_md">
    <com.google.android.material.button.MaterialButton
      android:id="@+id/b_save_custom_color"
      style="@style/Widget.GalIsland.Button.Outlined"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/save_custom_color" />
    <com.google.android.material.button.MaterialButton
      android:id="@+id/b_restore_defaults"
      style="@style/Widget.GalIsland.Button.Outlined"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/restore_defaults" />
  </LinearLayout>
</LinearLayout>
