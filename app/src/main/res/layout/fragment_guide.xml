<?xml version="1.0" encoding="utf-8"?>
<com.cyh128.hikari_novel.ui.other.GalislandGridConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="?android:attr/colorBackground">
  <androidx.core.widget.NestedScrollView
    android:id="@+id/nsv_f_guide_content"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="@dimen/gi_space_lg"
    app:layout_constraintBottom_toTopOf="@id/ll_f_guide_actions"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center"
      android:orientation="vertical"
      android:paddingTop="@dimen/gi_space_xl">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <ImageView
          android:layout_width="wrap_content"
          android:layout_height="@dimen/gi_guide_logo_height"
          android:src="@drawable/logo_header"
          tools:ignore="ContentDescription" />
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.Heading"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/guide_1"
          android:textStyle="bold" />
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.CardTitle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/gi_space_inset"
          android:text="@string/guide_2" />
      </LinearLayout>
      <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_a_guide_recommend"
        style="@style/Widget.GalIsland.CardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/gi_space_gap_xl">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:padding="@dimen/gi_space_md">
          <ImageView
            android:layout_width="@dimen/gi_control_icon"
            android:layout_height="@dimen/gi_control_icon"
            android:layout_gravity="center_vertical"
            android:contentDescription="@null"
            android:src="@drawable/ic_info" />
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/gi_space_gap_md"
            android:orientation="vertical">
            <TextView
              android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/guide_3"
              android:textStyle="bold" />
            <TextView
              android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Body"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/gi_space_gap_xs"
              android:text="@string/guide_4" />
            <TextView
              android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/gi_space_inset"
              android:text="@string/guide_5"
              android:textStyle="bold" />
            <TextView
              android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Body"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/gi_space_gap_xs"
              android:text="@string/guide_6" />
            <TextView
              android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/gi_space_inset"
              android:text="@string/disclaimers"
              android:textStyle="bold" />
            <TextView
              android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Body"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/gi_space_gap_xs"
              android:text="@string/guide_7" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
          android:minHeight="@dimen/gi_control_height"
          android:id="@+id/b_f_guide_using_help"
          style="@style/Widget.GalIsland.Button.Text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal"
          android:text="@string/using_help"
          app:icon="@drawable/ic_help" />
        <com.google.android.material.button.MaterialButton
          android:minHeight="@dimen/gi_control_height"
          android:id="@+id/b_f_guide_disclaimers"
          style="@style/Widget.GalIsland.Button.Text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal"
          android:text="@string/disclaimers"
          app:icon="@drawable/ic_contract" />
      </LinearLayout>
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
  <LinearLayout
    android:id="@+id/ll_f_guide_actions"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="@dimen/gi_space_gap_xl"
    android:paddingTop="@dimen/gi_space_sm"
    android:paddingRight="@dimen/gi_space_gap_xl"
    android:paddingBottom="@dimen/gi_space_gap_xl"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent">
    <com.google.android.material.checkbox.MaterialCheckBox
      android:id="@+id/cb_f_guide_accept"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/guide_8" />
    <com.google.android.material.button.MaterialButton
      android:minHeight="@dimen/gi_control_height"
      style="@style/Widget.GalIsland.Button"
      android:id="@+id/b_f_guide_go_on"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:enabled="false"
      android:pointerIcon="copy"
      android:text="@string/go_on"
      app:iconGravity="end" />
  </LinearLayout>
</com.cyh128.hikari_novel.ui.other.GalislandGridConstraintLayout>
