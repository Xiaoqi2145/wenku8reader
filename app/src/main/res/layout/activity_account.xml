<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="?android:attr/colorBackground">
  <com.google.android.material.appbar.AppBarLayout
    android:elevation="0dp"
    android:background="?attr/giSurfaceToolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="true"
    style="@style/Widget.GalIsland.AppBar">
    <com.google.android.material.appbar.MaterialToolbar
      style="@style/Widget.GalIsland.Secondary.Toolbar"
      android:id="@+id/tb_a_account"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:title="@string/account" />
  </com.google.android.material.appbar.AppBarLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <com.google.android.material.card.MaterialCardView
      style="@style/Widget.GalIsland.CardView"
      android:layout_width="@dimen/gi_metric_120dp"
      android:layout_height="@dimen/gi_metric_120dp"
      android:layout_gravity="center_horizontal"
      android:layout_marginBottom="@dimen/gi_metric_30dp"
      android:layout_marginTop="@dimen/gi_metric_30dp"
      app:cardCornerRadius="@dimen/gi_space_sm"
      app:cardElevation="0dp">
      <ImageView
        android:id="@+id/iv_a_account"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.button.MaterialButton
      android:minHeight="@dimen/gi_control_height"
      style="@style/Widget.GalIsland.Button"
      android:id="@+id/b_a_account_sign_in"
      android:layout_gravity="center_horizontal"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/sign_in"
      app:icon="@drawable/ic_event_available"
      android:layout_marginBottom="@dimen/gi_control_icon" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:layout_marginLeft="@dimen/gi_metric_30dp"
      android:layout_marginRight="@dimen/gi_metric_30dp">
      <LinearLayout
        android:layout_margin="@dimen/gi_metric_5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/user_id" />
        <View
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1" />
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
          android:id="@+id/tv_a_account_user_id"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
      </LinearLayout>
      <LinearLayout
        android:layout_margin="@dimen/gi_metric_5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/wenku8_username" />
        <View
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1" />
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
          android:id="@+id/tv_a_account_username"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
      </LinearLayout>
      <LinearLayout
        android:layout_margin="@dimen/gi_metric_5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/level" />
        <View
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1" />
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
          android:id="@+id/tv_a_account_level"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
      </LinearLayout>
      <LinearLayout
        android:layout_margin="@dimen/gi_metric_5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/email" />
        <View
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1" />
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
          android:id="@+id/tv_a_account_email"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
      </LinearLayout>
      <LinearLayout
        android:layout_margin="@dimen/gi_metric_5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/register_date" />
        <View
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1" />
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
          android:id="@+id/tv_a_account_register_date"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
      </LinearLayout>
      <LinearLayout
        android:layout_margin="@dimen/gi_metric_5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/contribution" />
        <View
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1" />
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
          android:id="@+id/tv_a_account_contribution"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
      </LinearLayout>
      <LinearLayout
        android:layout_margin="@dimen/gi_metric_5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/experience" />
        <View
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1" />
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
          android:id="@+id/tv_a_account_experience"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
      </LinearLayout>
      <LinearLayout
        android:layout_margin="@dimen/gi_metric_5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/current_point" />
        <View
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1" />
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
          android:id="@+id/tv_a_account_current_point"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
      </LinearLayout>
      <LinearLayout
        android:layout_margin="@dimen/gi_metric_5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/max_bookshelf_number" />
        <View
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1" />
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
          android:id="@+id/tv_a_account_max_bookshelf_number"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
      </LinearLayout>
      <LinearLayout
        android:layout_margin="@dimen/gi_metric_5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/daily_max_recommend_number" />
        <View
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1" />
        <TextView
          android:textAppearance="@style/TextAppearance.GalIsland.Secondary.Title"
          android:id="@+id/tv_a_account_daily_max_recommend_number"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />
      </LinearLayout>
    </LinearLayout>
    <View
      android:layout_width="wrap_content"
      android:layout_height="0dp"
      android:layout_weight="1" />
    <com.google.android.material.button.MaterialButton
      android:minHeight="@dimen/gi_control_height"
      android:id="@+id/b_a_account"
      style="@style/Widget.GalIsland.Button.Outlined"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center|bottom"
      android:layout_marginBottom="@dimen/gi_metric_50dp"
      android:text="@string/logout"
      android:textColor="?attr/colorError"
      app:icon="@drawable/ic_logout"
      app:iconTint="?attr/colorError"
      app:strokeColor="?attr/colorError" />
  </LinearLayout>
</LinearLayout>