<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_margin="@dimen/gi_space_sm"
  android:padding="@dimen/gi_space_sm"
  android:background="@drawable/gi_panel">
  <LinearLayout
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/gi_space_inset"
    android:paddingBottom="@dimen/gi_space_inset">
    <com.google.android.material.card.MaterialCardView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      style="@style/Widget.GalIsland.CardView.Cover">
      <ImageView
        android:id="@+id/iv_i_visit_history"
        android:layout_width="@dimen/gi_metric_90dp"
        android:layout_height="@dimen/gi_cover_width"
        android:scaleType="centerCrop" />
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout
      android:layout_marginLeft="@dimen/gi_control_icon"
      android:layout_marginRight="@dimen/gi_space_inset"
      android:orientation="vertical"
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content">
      <TextView
        android:id="@+id/tv_i_visit_history_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.GalIsland.CardTitle"
        android:ellipsize="end"
        android:singleLine="true"
        android:layout_marginBottom="@dimen/gi_radius_tag"
        tools:text="title" />
      <TextView
        android:id="@+id/tv_i_visit_history_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.GalIsland.CardSubtitle"
        tools:text="time" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
      android:id="@+id/b_i_visit_history"
      style="@style/Widget.GalIsland.Button.IconButton"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      app:icon="@drawable/ic_delete" />
  </LinearLayout>
</LinearLayout>
