<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ GalIsland 视觉体系：形状层级 / 组件样式 / 字体尺度
  ~ 对应 GalIsland UI Template 的 tokens.css 与 components.css
  ~
  ~ 形状：control 7dp / card 8dp / window 10dp / tag 6dp
  ~ 卡片：1dp 细描边（outlineVariant）+ 8dp 圆角 + 无阴影
-->
<resources>
  <!-- ===================== 形状层级 ===================== -->
  <style name="ShapeAppearance.GalIsland.Tag" parent="">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">@dimen/gi_radius_tag</item>
  </style>
  <style name="ShapeAppearance.GalIsland.Small" parent="">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">@dimen/gi_radius_control</item>
  </style>
  <style name="ShapeAppearance.GalIsland.Medium" parent="">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">@dimen/gi_radius_card</item>
  </style>
  <style name="ShapeAppearance.GalIsland.Large" parent="">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">@dimen/gi_radius_window</item>
  </style>
  <!-- ===================== 字体尺度 ===================== -->
  <style name="TextAppearance.GalIsland.CardTitle" parent="TextAppearance.Material3.TitleSmall">
    <item name="android:textSize">@dimen/gi_text_card_title</item>
    <item name="android:textColor">?attr/colorOnSurface</item>
    <item name="android:letterSpacing">0</item>
  </style>
  <style name="TextAppearance.GalIsland.CardSubtitle" parent="TextAppearance.Material3.BodySmall">
    <item name="android:textSize">@dimen/gi_text_meta</item>
    <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    <item name="android:letterSpacing">0</item>
  </style>
  <style name="TextAppearance.GalIsland.Meta" parent="TextAppearance.Material3.BodySmall">
    <item name="android:textSize">@dimen/gi_text_body</item>
    <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    <item name="android:letterSpacing">0</item>
  </style>
  <style name="TextAppearance.GalIsland.SectionTitle" parent="TextAppearance.Material3.TitleSmall">
    <item name="android:textSize">@dimen/gi_text_section</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">?attr/colorOnSurface</item>
    <item name="android:letterSpacing">0</item>
  </style>
  <style name="TextAppearance.GalIsland.Eyebrow" parent="TextAppearance.Material3.LabelSmall">
    <item name="android:textSize">@dimen/gi_text_micro</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">?attr/colorPrimary</item>
  </style>
  <style name="TextAppearance.GalIsland.Button" parent="TextAppearance.Material3.LabelLarge">
    <item name="android:textSize">@dimen/gi_text_body</item>
    <item name="android:textStyle">bold</item>
    <item name="android:letterSpacing">0.01</item>
  </style>
  <style name="TextAppearance.GalIsland.Tab" parent="TextAppearance.Material3.TitleSmall">
    <item name="android:textSize">@dimen/gi_text_section</item>
    <item name="android:textStyle">bold</item>
    <item name="android:letterSpacing">0</item>
  </style>
  <style name="TextAppearance.GalIsland.Tag" parent="TextAppearance.Material3.LabelSmall">
    <item name="android:textSize">@dimen/gi_text_micro</item>
    <item name="android:letterSpacing">0</item>
  </style>
  <style name="TextAppearance.GalIsland.ChipLabel" parent="TextAppearance.Material3.LabelLarge">
    <item name="android:textSize">@dimen/gi_text_body</item>
    <item name="android:letterSpacing">0</item>
  </style>
  <style name="TextAppearance.GalIsland.EmptyTitle" parent="TextAppearance.Material3.TitleMedium">
    <item name="android:textSize">@dimen/gi_text_empty_title</item>
    <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    <item name="android:letterSpacing">0</item>
  </style>
  <!-- ===================== 卡片 ===================== -->
  <!-- 细描边 + 8dp 圆角，无阴影（模板 .library-card） -->
  <style name="Widget.GalIsland.CardView" parent="Widget.Material3.CardView.Filled">
    <item name="cardBackgroundColor">@android:color/transparent</item>
    <item name="cardCornerRadius">@dimen/gi_radius_card</item>
    <item name="cardElevation">0dp</item>
    <item name="strokeWidth">@dimen/gi_stroke</item>
    <item name="strokeColor">?attr/colorOutlineVariant</item>
  </style>
  <!-- Transparent information cards preserve the grid surface. -->
  <style name="Widget.GalIsland.CardView.Outline" parent="Widget.GalIsland.CardView">
    <item name="cardBackgroundColor">@android:color/transparent</item>
  </style>
  <style name="Widget.GalIsland.CardView.Filled" parent="Widget.GalIsland.CardView">
    <item name="cardBackgroundColor">?attr/giSurfaceReaderChrome</item>
  </style>
  <!-- 纯图片容器：8dp 圆角、无描边（模板 .card-cover） -->
  <style name="Widget.GalIsland.CardView.Cover" parent="Widget.GalIsland.CardView">
    <item name="strokeWidth">0dp</item>
  </style>
  <!-- 小说卡片：模板式 8dp 圆角、细描边、零高程。
       底色透明（无纯色填充），只保留缩略图 + 标题，让底层网格表面透出；
       描边仍保留，否则 gi_card_stroke 的选中态主色描边无处可见。 -->
  <style name="Widget.GalIsland.CardView.Novel" parent="Widget.Material3.CardView.Filled">
    <item name="cardCornerRadius">@dimen/gi_radius_card_novel</item>
    <item name="cardElevation">0dp</item>
    <item name="strokeWidth">@dimen/gi_stroke</item>
    <item name="cardBackgroundColor">@android:color/transparent</item>
    <item name="strokeColor">?attr/colorOutlineVariant</item>
  </style>
  <style name="Widget.GalIsland.CardView.Novel.Cover" parent="Widget.GalIsland.CardView.Novel">
    <item name="cardCornerRadius">@dimen/gi_radius_cover_novel</item>
    <!-- 封面容器无描边（模板 .card-cover）；elevation 继承父样式 0dp。 -->
    <item name="strokeWidth">0dp</item>
  </style>
  <!-- 列表式小说卡片的封面沿用外卡圆角 -->
  <style name="Widget.GalIsland.CardView.Novel.Cover.Liner" parent="Widget.GalIsland.CardView.Novel">
    <item name="cardCornerRadius">@dimen/gi_radius_card_novel</item>
  </style>
  <!-- ===================== 进度条 ===================== -->
  <!-- 细轨滑块，配合阅读底栏与设置面板 -->
  <style name="Widget.GalIsland.Slider" parent="Widget.Material3.Slider">
    <item name="trackHeight">@dimen/gi_slider_track_height</item>
    <item name="thumbRadius">@dimen/gi_slider_thumb_radius</item>
    <item name="tickVisible">false</item>
    <item name="haloRadius">@dimen/gi_slider_halo_radius</item>
  </style>
  <!-- ===================== 开关 ===================== -->
  <!-- 规范第 3 节禁止使用未映射的 Material3 默认组件样式；此前 materialSwitchStyle 缺位，
       10 处 MaterialSwitch 全部落到 M3 默认样式。开关本体尺寸沿用 M3（不缩小，保证手势可达性），
       只把触控目标对齐 GalIsland 控件高度。 -->
  <style name="Widget.GalIsland.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
    <item name="android:minHeight">@dimen/gi_control_height</item>
  </style>
  <!-- ===================== 工具栏 ===================== -->
  <style name="Widget.GalIsland.Toolbar" parent="Widget.Material3.Toolbar">
    <item name="titleTextAppearance">@style/TextAppearance.GalIsland.Heading</item>
    <item name="android:background">@android:color/transparent</item>
    <item name="android:minHeight">@dimen/gi_toolbar_height</item>
    <item name="navigationIconTint">?attr/colorOnSurfaceVariant</item>
  </style>
  <style name="TextAppearance.GalIsland.Heading" parent="TextAppearance.Material3.TitleLarge">
    <item name="android:textSize">@dimen/gi_text_heading</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">?attr/colorOnSurface</item>
    <item name="android:letterSpacing">0</item>
  </style>
  <!-- 小说卡片标题：紧凑 14sp，允许卡片布局显示两行。 -->
  <style name="TextAppearance.GalIsland.NovelTitle" parent="TextAppearance.Material3.BodyMedium">
    <item name="android:textSize">@dimen/gi_text_card_title</item>
    <item name="android:textColor">?attr/colorOnSurface</item>
    <item name="android:letterSpacing">0</item>
  </style>
  <!-- 列表主标题（目录/章节） -->
  <style name="TextAppearance.GalIsland.ListTitle" parent="TextAppearance.Material3.BodyMedium">
    <item name="android:textSize">@dimen/gi_text_list_title</item>
    <item name="android:textColor">?attr/colorOnSurface</item>
    <item name="android:letterSpacing">0</item>
  </style>
  <!-- 列表标记文字（如“当前章节”） -->
  <style name="TextAppearance.GalIsland.ListMark" parent="TextAppearance.Material3.LabelMedium">
    <item name="android:textSize">@dimen/gi_text_body</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">?attr/colorPrimary</item>
  </style>
  <!-- 面板标题（底部弹层标题栏） -->
  <style name="TextAppearance.GalIsland.SheetTitle" parent="TextAppearance.Material3.TitleMedium">
    <item name="android:textSize">@dimen/gi_text_sheet_title</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">?attr/colorOnSurface</item>
    <item name="android:letterSpacing">0</item>
  </style>
  <!-- 阅读设置面板标签 -->
  <style name="TextAppearance.GalIsland.ConfigLabel" parent="TextAppearance.Material3.BodyMedium">
    <item name="android:textSize">@dimen/gi_text_config</item>
    <item name="android:textColor">?attr/colorOnSurface</item>
    <item name="android:letterSpacing">0</item>
  </style>
  <!-- 阅读页状态栏文字（时间/电量/百分比） -->
  <style name="TextAppearance.GalIsland.StatusText" parent="TextAppearance.Material3.BodySmall">
    <item name="android:textSize">@dimen/gi_text_meta</item>
    <item name="android:textColor">?android:attr/textColorSecondary</item>
    <item name="android:letterSpacing">0</item>
  </style>
  <!-- ===================== 按钮 ===================== -->
  <style name="Widget.GalIsland.Button" parent="Widget.Material3.Button">
    <item name="shapeAppearance">@style/ShapeAppearance.GalIsland.Small</item>
    <item name="android:textAppearance">@style/TextAppearance.GalIsland.Button</item>
    <item name="android:minHeight">@dimen/gi_control_height</item>
    <item name="iconSize">@dimen/gi_control_icon</item>
  </style>
  <style name="Widget.GalIsland.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
    <item name="shapeAppearance">@style/ShapeAppearance.GalIsland.Small</item>
    <item name="android:textAppearance">@style/TextAppearance.GalIsland.Button</item>
    <item name="android:minHeight">@dimen/gi_control_height</item>
    <item name="iconSize">@dimen/gi_control_icon</item>
  </style>
  <style name="Widget.GalIsland.Button.Text" parent="Widget.Material3.Button.TextButton">
    <item name="shapeAppearance">@style/ShapeAppearance.GalIsland.Small</item>
    <item name="android:textAppearance">@style/TextAppearance.GalIsland.Button</item>
    <item name="android:minHeight">@dimen/gi_control_height</item>
    <item name="iconSize">@dimen/gi_control_icon</item>
  </style>
  <style name="Widget.GalIsland.Button.Text.Icon" parent="Widget.Material3.Button.TextButton.Icon">
    <item name="shapeAppearance">@style/ShapeAppearance.GalIsland.Small</item>
    <item name="android:textAppearance">@style/TextAppearance.GalIsland.Button</item>
    <item name="android:minHeight">@dimen/gi_control_height</item>
    <item name="iconSize">@dimen/gi_control_icon</item>
  </style>
  <style name="Widget.GalIsland.Button.IconButton" parent="Widget.Material3.Button.IconButton">
    <item name="shapeAppearance">@style/ShapeAppearance.GalIsland.Small</item>
    <item name="android:minHeight">@dimen/gi_control_height</item>
    <item name="iconSize">@dimen/gi_control_icon</item>
    <item name="android:minWidth">@dimen/gi_icon_button_size</item>
    <item name="android:insetTop">@dimen/gi_space_xs</item>
    <item name="android:insetBottom">@dimen/gi_space_xs</item>
    <item name="strokeWidth">@dimen/gi_stroke</item>
    <item name="strokeColor">?attr/colorOutlineVariant</item>
    <item name="iconTint">?attr/colorOnSurfaceVariant</item>
  </style>
  <!-- ===================== Chip / 标签 ===================== -->
  <!-- 标签：细描边、小字号、紧凑高度（模板 .tag） -->
  <style name="Widget.GalIsland.Chip" parent="Widget.Material3.Chip.Assist">
    <item name="shapeAppearance">@style/ShapeAppearance.GalIsland.Tag</item>
    <item name="chipMinHeight">@dimen/gi_chip_height</item>
    <item name="chipStrokeWidth">@dimen/gi_stroke</item>
    <item name="chipStrokeColor">?attr/colorOutlineVariant</item>
    <item name="chipBackgroundColor">@color/gi_chip_background</item>
    <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    <item name="android:textAppearance">@style/TextAppearance.GalIsland.Tag</item>
    <item name="chipIconVisible">false</item>
    <item name="ensureMinTouchTargetSize">false</item>
  </style>
  <style name="Widget.GalIsland.Chip.Suggestion" parent="Widget.Material3.Chip.Suggestion">
    <item name="shapeAppearance">@style/ShapeAppearance.GalIsland.Small</item>
    <item name="chipMinHeight">@dimen/gi_chip_touch_height</item>
    <item name="android:textAppearance">@style/TextAppearance.GalIsland.ChipLabel</item>
    <item name="chipStrokeWidth">@dimen/gi_stroke</item>
    <item name="chipStrokeColor">?attr/colorOutlineVariant</item>
    <item name="chipBackgroundColor">@color/gi_chip_background</item>
    <item name="ensureMinTouchTargetSize">true</item>
    <item name="chipMinTouchTargetSize">@dimen/gi_control_height</item>
  </style>
  <style name="Widget.GalIsland.Chip.Filter" parent="Widget.Material3.Chip.Filter">
    <item name="shapeAppearance">@style/ShapeAppearance.GalIsland.Small</item>
    <item name="chipMinHeight">@dimen/gi_chip_touch_height</item>
    <item name="chipStrokeWidth">@dimen/gi_stroke</item>
    <item name="chipStrokeColor">?attr/colorOutlineVariant</item>
    <item name="android:textAppearance">@style/TextAppearance.GalIsland.ChipLabel</item>
    <item name="chipBackgroundColor">@color/gi_chip_background</item>
    <item name="ensureMinTouchTargetSize">true</item>
    <item name="chipMinTouchTargetSize">@dimen/gi_control_height</item>
  </style>
  <!-- ===================== Tab ===================== -->
  <!-- 3dp 主色指示条、加粗 13sp 标签（模板侧栏激活态） -->
  <style name="Widget.GalIsland.TabLayout" parent="Widget.Material3.TabLayout">
    <item name="tabIndicatorColor">?attr/colorPrimary</item>
    <item name="tabIndicatorHeight">@dimen/gi_tab_indicator_height</item>
    <item name="tabIndicatorFullWidth">false</item>
    <item name="tabSelectedTextColor">?attr/colorPrimary</item>
    <item name="tabTextColor">?attr/colorOnSurfaceVariant</item>
    <item name="tabTextAppearance">@style/TextAppearance.GalIsland.Tab</item>
    <item name="tabRippleColor">@color/galisland_interaction</item>
    <item name="android:background">@android:color/transparent</item>
  </style>
  <!-- ===================== 底部导航激活指示器 ===================== -->
  <!-- 复刻模板 nav-item.is-active：淡主色底 + 7dp 圆角 -->
  <style name="Widget.GalIsland.NavigationBar.ActiveIndicator" parent="">
    <item name="android:width">@dimen/gi_nav_indicator_width</item>
    <item name="android:height">@dimen/gi_nav_indicator_height</item>
    <item name="android:color">@color/galisland_nav_indicator</item>
    <item name="shapeAppearance">@style/ShapeAppearance.GalIsland.Small</item>
  </style>
  <!-- ===================== 输入框 ===================== -->
  <style name="Widget.GalIsland.TextInputLayout.OutlinedBox" parent="Widget.Material3.TextInputLayout.OutlinedBox">
    <item name="boxCornerRadiusTopStart">@dimen/gi_radius_control</item>
    <item name="boxCornerRadiusTopEnd">@dimen/gi_radius_control</item>
    <item name="boxCornerRadiusBottomStart">@dimen/gi_radius_control</item>
    <item name="boxCornerRadiusBottomEnd">@dimen/gi_radius_control</item>
    <item name="boxStrokeWidth">@dimen/gi_stroke</item>
    <item name="boxStrokeWidthFocused">@dimen/gi_stroke</item>
    <item name="boxStrokeColor">@color/galisland_box_stroke</item>
    <item name="hintTextColor">?attr/colorPrimary</item>
    <item name="boxBackgroundColor">?attr/giSurfaceInput</item>
  </style>
  <style name="Widget.GalIsland.TextInputLayout.OutlinedBox.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
    <item name="boxCornerRadiusTopStart">@dimen/gi_radius_control</item>
    <item name="boxCornerRadiusTopEnd">@dimen/gi_radius_control</item>
    <item name="boxCornerRadiusBottomStart">@dimen/gi_radius_control</item>
    <item name="boxCornerRadiusBottomEnd">@dimen/gi_radius_control</item>
    <item name="boxStrokeWidth">@dimen/gi_stroke</item>
    <item name="boxStrokeWidthFocused">@dimen/gi_stroke</item>
    <item name="boxStrokeColor">@color/galisland_box_stroke</item>
    <item name="hintTextColor">?attr/colorPrimary</item>
    <item name="boxBackgroundColor">?attr/giSurfaceInput</item>
  </style>
  <!-- ===================== 提示条 ===================== -->
  <style name="Widget.GalIsland.Snackbar" parent="Widget.Material3.Snackbar">
    <item name="backgroundTint">?attr/giSurfaceReaderChrome</item>
    <item name="shapeAppearance">@style/ShapeAppearance.GalIsland.Small</item>
    <item name="android:textColor">?attr/colorOnSurface</item>
  </style>
  <style name="Widget.GalIsland.Snackbar.TextView" parent="Widget.Material3.Snackbar.TextView">
    <item name="android:textColor">?attr/colorOnSurface</item>
  </style>
  <!-- END-side catalog enters like a lightweight mobile drawer. -->
  <style name="Animation.GalIsland.ReadCatalog" parent="@android:style/Animation.Dialog">
    <item name="android:windowEnterAnimation">@anim/slide_in_right</item>
    <item name="android:windowExitAnimation">@anim/slide_out_right</item>
  </style>
  <!-- ===================== 对话框 ===================== -->
  <style name="Widget.GalIsland.AlertDialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
    <item name="android:textAppearance">@style/TextAppearance.GalIsland.SectionTitle</item>
  </style>
  <style name="ThemeOverlay.GalIsland.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
    <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.GalIsland.Medium</item>
    <item name="materialAlertDialogTitleTextStyle">@style/Widget.GalIsland.AlertDialog.Title</item>
  </style>
</resources>
