<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Base application theme. -->
  <style name="Base.Theme.HikariNovel" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
    <!-- Customize your light theme here. -->
    <!-- GalIsland 视觉体系 -->
    <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.GalIsland.Small</item>
    <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.GalIsland.Medium</item>
    <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.GalIsland.Large</item>
    <item name="materialCardViewStyle">@style/Widget.GalIsland.CardView</item>
    <item name="materialButtonStyle">@style/Widget.GalIsland.Button</item>
    <item name="chipStyle">@style/Widget.GalIsland.Chip</item>
    <item name="tabStyle">@style/Widget.GalIsland.TabLayout</item>
    <item name="toolbarStyle">@style/Widget.GalIsland.Toolbar</item>
    <item name="sliderStyle">@style/Widget.GalIsland.Slider</item>
    <item name="textInputStyle">@style/Widget.GalIsland.TextInputLayout.OutlinedBox</item>
    <item name="snackbarStyle">@style/Widget.GalIsland.Snackbar</item>
    <item name="snackbarTextViewStyle">@style/Widget.GalIsland.Snackbar.TextView</item>
    <item name="materialAlertDialogTheme">@style/ThemeOverlay.GalIsland.MaterialAlertDialog</item>
    <item name="giSurfaceInput">?attr/colorSurfaceVariant</item>
    <item name="giSurfaceHover">?attr/colorSurfaceContainerHigh</item>
    <item name="appBarLayoutStyle">@style/Widget.GalIsland.AppBar</item>
    <item name="giAccentSoft">@color/galisland_nav_indicator</item>
    <item name="bottomSheetDialogTheme">@style/ThemeOverlay.GalIsland.BottomSheet</item>
    <item name="giBorderStrong">?attr/colorOutline</item>
    <item name="giSurfaceSidebar">?attr/colorSurfaceContainerLow</item>
    <item name="giSurfaceToolbar">?attr/colorSurface</item>
    <item name="elevationOverlayEnabled">false</item>
